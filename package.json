{
  "name": "dynamic-survey-app",
  "version": "2.0.0",
  "description": "Aplicación moderna y minimalista para crear, gestionar y analizar encuestas dinámicas",
  "author": "Santiago Dev <santiago@dinamicsurveys.com>",
  "license": "MIT",
  "keywords": [
    "angular",
    "survey",
    "forms",
    "material-design",
    "typescript",
    "responsive",
    "minimalista"
  ],
  "homepage": "https://github.com/Santiago13dev/dynamic-survey-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Santiago13dev/dynamic-survey-app.git"
  },
  "bugs": {
    "url": "https://github.com/Santiago13dev/dynamic-survey-app/issues"
  },
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "dev": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --code-coverage",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "e2e": "ng e2e",
    "analyze": "ng build --configuration production --stats-json && npx webpack-bundle-analyzer dist/dynamic-survey-app/stats.json",
    "extract-i18n": "ng extract-i18n",
    "serve:prod": "ng build --configuration production && npx http-server dist/dynamic-survey-app -p 8080",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "clean": "rimraf dist/ node_modules/.cache/",
    "postinstall": "ngcc"
  },
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/cdk": "^17.3.7",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/material": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@angular/service-worker": "^17.0.0",
    "chart.js": "^4.4.0",
    "file-saver": "^2.0.5",
    "jspdf": "^2.5.1",
    "ng2-charts": "^4.0.1",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@angular-eslint/builder": "^17.0.0",
    "@angular-eslint/eslint-plugin": "^17.0.0",
    "@angular-eslint/eslint-plugin-template": "^17.0.0",
    "@angular-eslint/schematics": "^17.0.0",
    "@angular-eslint/template-parser": "^17.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^20.5.9",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-headless": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.0.0",
    "protractor": "~7.0.0",
    "rimraf": "^5.0.0",
    "typescript": "5.2.2",
    "webpack-bundle-analyzer": "^4.9.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not IE 11"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "contributors": [
    {
      "name": "Santiago Dev",
      "email": "santiago@dinamicsurveys.com",
      "url": "https://github.com/Santiago13dev"
    }
  ]
}